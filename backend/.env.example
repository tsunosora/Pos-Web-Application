# Database (MySQL)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/pospro"

# Auth
JWT_SECRET="your_long_random_secret_here"
# Masa berlaku token login (mis. 1d, 12h). Pendek = lebih aman. Default: 1d
JWT_EXPIRES="1d"

# Server
PORT=3001

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000"

# WhatsApp Bot (opsional) — nonaktif secara default, notifikasi memakai Discord.
# Set "true" untuk menghidupkan bot WA (perlu scan QR saat start).
WHATSAPP_ENABLED="false"
WHATSAPP_REPORT_GROUP_ID=""

# --- WhatsApp Cloud API resmi Meta (PER CABANG) — modul whatsapp-cloud ---
# phone_number_id & waba_id TIDAK di sini — disimpan per WaChannel di DB.
# Satu token System User level-Business mengelola semua nomor/WABA di bawah Business.
WA_CLOUD_ENABLED="false"
WA_GRAPH_VERSION="v23.0"
WA_ACCESS_TOKEN=""            # permanent System User token (Business-level)
WA_APP_SECRET=""             # verifikasi signature webhook X-Hub-Signature-256
WA_VERIFY_TOKEN=""           # string acak buatan sendiri utk GET verify webhook
WA_BROADCAST_RATE_PER_SEC="10"
# Auto-buat Lead dari chat WA baru (nomor yg belum jadi lead). "false" = matikan.
WA_AUTO_CREATE_LEAD="true"
# Folder arsip media WA di server (opsional; default: <backend>/storage/wa-media)
WA_MEDIA_DIR=""
