# Database (MySQL)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/pospro"

# Auth
JWT_SECRET="your_long_random_secret_here"
# Masa berlaku token login (mis. 1d, 12h). Pendek = lebih aman. Default: 1d
JWT_EXPIRES="1d"

# Server
PORT=3001

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000"

# WhatsApp Bot (opsional) — nonaktif secara default, notifikasi memakai Discord.
# Set "true" untuk menghidupkan bot WA (perlu scan QR saat start).
WHATSAPP_ENABLED="false"
WHATSAPP_REPORT_GROUP_ID=""
