# Database (MySQL)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/pospro"

# Auth
JWT_SECRET="your_long_random_secret_here"
# Masa berlaku token login (mis. 1d, 12h). Pendek = lebih aman. Default: 1d
JWT_EXPIRES="1d"

# Server
PORT=3001

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000"

# WhatsApp Bot (opsional) — nonaktif secara default, notifikasi memakai Discord.
# Set "true" untuk menghidupkan bot WA (perlu scan QR saat start).
WHATSAPP_ENABLED="false"
WHATSAPP_REPORT_GROUP_ID=""

# --- WhatsApp Cloud API resmi Meta (PER CABANG) — modul whatsapp-cloud ---
# phone_number_id & waba_id TIDAK di sini — disimpan per WaChannel di DB.
# Satu token System User level-Business mengelola semua nomor/WABA di bawah Business.
WA_CLOUD_ENABLED="false"
WA_GRAPH_VERSION="v23.0"
WA_ACCESS_TOKEN=""            # permanent System User token (Business-level)
WA_APP_SECRET=""             # verifikasi signature webhook X-Hub-Signature-256
WA_APP_ID=""                 # App ID Meta — utk unggah foto profil (Resumable Upload API)
WA_VERIFY_TOKEN=""           # string acak buatan sendiri utk GET verify webhook
WA_BROADCAST_RATE_PER_SEC="10"
# Auto-buat Lead dari chat WA baru (nomor yg belum jadi lead). "false" = matikan.
WA_AUTO_CREATE_LEAD="true"
# Folder arsip media WA di server (opsional; default: <backend>/storage/wa-media)
WA_MEDIA_DIR=""
# Retensi FILE media WA (hari). Auto-cleanup harian 03:00 menghapus file lebih tua
# dari ini (riwayat chat/caption TETAP). Default 30 (1 bulan). 0/kosong-negatif = matikan.
WA_MEDIA_RETENTION_DAYS="30"

# ── AI Studio Desain (Asisten "Isi Otomatis") ─────────────────────────────
# UTAMA: diatur Owner via panel /owner ("AI Studio Desain") → disimpan sbg file
# JSON (backend/storage/studio-ai-config.json). Env di bawah HANYA fallback/default
# awal — boleh dikosongkan kalau pakai panel.
#
# Endpoint OpenAI-compatible (/v1/chat/completions). Kompatibel 9router
# (github.com/decolua/9router), OpenRouter, OpenAI. Kalau 9router di PC (bukan
# server), hubungkan PC↔server via Tailscale lalu isi Base URL = IP Tailscale PC.
AI_ENABLED="false"                        # true = aktifkan tanpa perlu buka panel
AI_BASE_URL="http://localhost:20128/v1"   # default kalau panel & file kosong
AI_API_KEY=""                             # Bearer token 9router (kosong = tanpa auth)
AI_MODEL="cc/claude-sonnet-4-5"           # <provider>/<model>
# Lokasi file config runtime (opsional). Default: <backend>/storage/studio-ai-config.json
# STUDIO_AI_CONFIG_PATH=""
